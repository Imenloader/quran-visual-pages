<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="12dp"
    android:background="@drawable/widget_background">

    <!-- Header: Dates and City -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp">

        <TextView
            android:id="@+id/widget_hijri_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1 ذو القعدة 1447"
            android:textColor="@color/widget_gold"
            android:textSize="11sp"
            android:textStyle="bold"
            android:layout_alignParentStart="true" />

        <TextView
            android:id="@+id/widget_city"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="القاهرة"
            android:textColor="@color/widget_text_secondary"
            android:textSize="10sp"
            android:layout_centerHorizontal="true" />

        <TextView
            android:id="@+id/widget_gregorian_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="1 May 2026"
            android:textColor="@color/widget_text_secondary"
            android:textSize="10sp"
            android:layout_alignParentEnd="true" />
    </RelativeLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/widget_divider"
        android:layout_marginBottom="12dp" />

    <!-- Main Section: Next Prayer -->
    <LinearLayout
        android:id="@+id/widget_main_click"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center">

        <TextView
            android:id="@+id/widget_prayer_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="صلاة المغرب"
            android:textColor="@color/widget_text_primary"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:45:12"
            android:textColor="@color/widget_gold"
            android:textSize="32sp"
            android:textStyle="bold"
            android:layout_marginTop="2dp" />
            
        <TextView
            android:id="@+id/widget_label_remaining"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="متبقي على الأذان"
            android:textColor="@color/widget_text_secondary"
            android:textSize="9sp"
            android:textStyle="bold"
            android:textAllCaps="true" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/widget_divider"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp" />

    <!-- Footer: Grid of all prayers -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="6">

        <!-- Fajr -->
        <LinearLayout
            android:id="@+id/container_fajr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="2dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="فجر" android:textColor="@color/widget_text_secondary" android:textSize="9sp" />
            <TextView android:id="@+id/widget_fajr_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="04:30" android:textColor="@color/widget_text_primary" android:textSize="11sp" android:textStyle="bold" />
        </LinearLayout>

        <!-- Sunrise -->
        <LinearLayout
            android:id="@+id/container_sunrise"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="2dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="شروق" android:textColor="@color/widget_text_secondary" android:textSize="9sp" />
            <TextView android:id="@+id/widget_sunrise_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="05:50" android:textColor="@color/widget_text_primary" android:textSize="11sp" android:textStyle="bold" />
        </LinearLayout>

        <!-- Dhuhr -->
        <LinearLayout
            android:id="@+id/container_dhuhr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="2dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ظهر" android:textColor="@color/widget_text_secondary" android:textSize="9sp" />
            <TextView android:id="@+id/widget_dhuhr_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="12:05" android:textColor="@color/widget_text_primary" android:textSize="11sp" android:textStyle="bold" />
        </LinearLayout>

        <!-- Asr -->
        <LinearLayout
            android:id="@+id/container_asr"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="2dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="عصر" android:textColor="@color/widget_text_secondary" android:textSize="9sp" />
            <TextView android:id="@+id/widget_asr_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="03:40" android:textColor="@color/widget_text_primary" android:textSize="11sp" android:textStyle="bold" />
        </LinearLayout>

        <!-- Maghrib -->
        <LinearLayout
            android:id="@+id/container_maghrib"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="2dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="مغرب" android:textColor="@color/widget_text_secondary" android:textSize="9sp" />
            <TextView android:id="@+id/widget_maghrib_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="06:45" android:textColor="@color/widget_text_primary" android:textSize="11sp" android:textStyle="bold" />
        </LinearLayout>

        <!-- Isha -->
        <LinearLayout
            android:id="@+id/container_isha"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="2dp">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="عشاء" android:textColor="@color/widget_text_secondary" android:textSize="9sp" />
            <TextView android:id="@+id/widget_isha_time" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="08:15" android:textColor="@color/widget_text_primary" android:textSize="11sp" android:textStyle="bold" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
