rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
          (request.auth.token.email == "3wdkyarb@gmail.com" && request.auth.token.email_verified == true)
        );
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================

    // Global Dhikr counter — public read, anyone can contribute
    match /stats/dhikr {
      allow read: if true;
      allow write: if true;
    }

    match /users/{userId} {
      // Allow any authenticated user to read profiles (needed for leaderboards)
      allow read: if isAuthenticated();
      
      // Allow only the owner to create/update their own profile
      // Hardened: Prevent users from changing their own 'role' to 'admin'
      allow create: if isOwner(userId) && request.resource.data.role == 'user';
      allow update: if (isOwner(userId) && request.resource.data.role == resource.data.role) || isAdmin();

      // RECURSIVE RULE: Allow owners full access to their personal sub-collections
      // This covers 'quran-favorites', 'quran-favorite-collections', 'data' (bookmarks), etc.
      match /{allPaths=**} {
        allow read, write: if isOwner(userId);
      }
    }

    match /khatmas/{khatmaId} {
      allow read: if isAuthenticated();
      
      // Allow creation by any authenticated user
      allow create: if isAuthenticated();
      
      // Allow update by any authenticated user (for claiming portions)
      // Hardened: Prevent changing the original creator or creation date
      allow update: if isAuthenticated() && 
                    request.resource.data.createdBy == resource.data.createdBy &&
                    request.resource.data.createdAt == resource.data.createdAt;
                    
      // Only the creator or an admin can delete a khatma
      allow delete: if isAuthenticated() && (resource.data.createdBy == request.auth.uid || isAdmin());
    }
  }
}
