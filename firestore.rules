rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------------------------------------------------
    // HELPER FUNCTIONS
    // ----------------------------------------------------------------------
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (
          (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin') ||
          (request.auth.token.email == "3wdkyarb@gmail.com" && request.auth.token.email_verified == true)
        );
    }

    // ----------------------------------------------------------------------
    // GLOBAL STATS
    // ----------------------------------------------------------------------
    match /stats/dhikr {
      allow read: if true;
      allow write: if true;
    }

    // ----------------------------------------------------------------------
    // APP CONTENT (CMS)
    // ----------------------------------------------------------------------
    
    // List of all content collections managed by the Admin Panel
    match /content_quiz/{id} { allow read: if true; allow write: if isAdmin(); }
    match /content_athkar/{id} { allow read: if true; allow write: if isAdmin(); }
    match /content_dua/{id} { allow read: if true; allow write: if isAdmin(); }
    match /content_hadiths/{id} { allow read: if true; allow write: if isAdmin(); }
    match /content_seerah/{id} { allow read: if true; allow write: if isAdmin(); }
    match /content_library/{id} { allow read: if true; allow write: if isAdmin(); }
    match /content_ramadan/{id} { allow read: if true; allow write: if isAdmin(); }
    match /content_prophet_stories/{id} { allow read: if true; allow write: if isAdmin(); }
    match /content_names_allah/{id} { allow read: if true; allow write: if isAdmin(); }
    match /content_sunan_friday/{id} { allow read: if true; allow write: if isAdmin(); }
    match /content_routine/{id} { allow read: if true; allow write: if isAdmin(); }

    // ----------------------------------------------------------------------
    // SETTINGS & SERVICES
    // ----------------------------------------------------------------------

    // Global App Settings (Maintenance, Maintenance mode, etc.)
    match /settings_global/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Website Services & Hub Settings
    match /services/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ----------------------------------------------------------------------
    // USERS
    // ----------------------------------------------------------------------
    match /users/{userId} {
      allow read: if isAuthenticated();
      
      // Prevent users from changing their own 'role' during creation
      allow create: if isOwner(userId) && (!request.resource.data.keys().contains('role') || request.resource.data.role == 'user');
      
      // Prevent users from changing their own 'role' during update
      allow update: if (isOwner(userId) && (!request.resource.data.keys().contains('role') || request.resource.data.role == resource.data.role)) || isAdmin();

      // Recursive rule for personal sync data (e.g., quran-favorites, data/bookmarks)
      match /{allPaths=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // ----------------------------------------------------------------------
    // KHATMAS
    // ----------------------------------------------------------------------
    match /khatmas/{khatmaId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      
      allow update: if isAuthenticated() && 
                    request.resource.data.createdBy == resource.data.createdBy &&
                    request.resource.data.createdAt == resource.data.createdAt;
                    
      allow delete: if isAuthenticated() && (resource.data.createdBy == request.auth.uid || isAdmin());
    }
  }
}
