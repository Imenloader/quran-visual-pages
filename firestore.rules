rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---
    function isAuthenticated() {
      return request.auth != null;
    }

    function isBanned() {
      return isAuthenticated() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isBanned', false) == true;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == "3wdkyarb@gmail.com" ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', 'user') == 'admin')
      );
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isMaintenanceOff() {
      let globalSettingsPath = /databases/$(database)/documents/settings/global;
      return !exists(globalSettingsPath) || 
             get(globalSettingsPath).data.get('maintenanceMode', false) == false;
    }

    function canWrite() {
      return isMaintenanceOff() || isAdmin();
    }

    // --- ADMIN ACTIVITIES ---
    match /admin_activities/{id} {
      allow create: if isAuthenticated(); 
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // --- GLOBAL STATS ---
    match /global_stats/{id} {
      allow read: if true;
      allow write: if isAuthenticated() && (canWrite() || isAdmin());

      match /participants/{userId} {
        allow read: if true;
        allow write: if isAuthenticated() && (request.auth.uid == userId) && (canWrite() || isAdmin());
      }
    }

    // --- PROFILES & SOCIAL ---
    match /profiles/{userId} {
      allow get, list: if isAuthenticated();
      allow write: if isOwner(userId) && canWrite();
    }

    match /activities/{activityId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if false; // Append-only
    }

    match /friendships/{shipId} {
      allow read: if isAuthenticated() && (request.auth.uid in resource.data.users);
      allow create: if isAuthenticated() && (request.auth.uid in request.resource.data.users);
      allow update: if isAuthenticated() && (request.auth.uid in resource.data.users);
      allow delete: if isAuthenticated() && (request.auth.uid in resource.data.users);
    }

    match /blocks/{blockId} {
      allow read: if isAuthenticated() && (request.auth.uid == resource.data.blocker);
      allow write: if isAuthenticated() && (request.auth.uid == request.resource.data.blocker);
    }

    match /stats/dhikr {
      allow read: if true;
      allow update: if isAuthenticated() && (canWrite() || isAdmin());
    }

    // --- APP CONTENT (CMS) ---
    match /content_quiz/{id} { allow read: if true; allow write: if isAdmin(); }
    match /content_athkar/{id} { allow read: if true; allow write: if isAdmin(); }
    match /content_duas/{id} { allow read: if true; allow write: if isAdmin(); }
    match /content_hadiths/{id} { allow read: if true; allow write: if isAdmin(); }
    match /content_seerah/{id} { allow read: if true; allow write: if isAdmin(); }
    match /content_library/{id} { allow read: if true; allow write: if isAdmin(); }
    match /content_ramadan/{id} { allow read: if true; allow write: if isAdmin(); }
    match /content_prophet_stories/{id} { allow read: if true; allow write: if isAdmin(); }
    match /content_names_of_allah/{id} { allow read: if true; allow write: if isAdmin(); }
    match /content_sunan_friday/{id} { allow read: if true; allow write: if isAdmin(); }
    match /content_routine/{id} { allow read: if true; allow write: if isAdmin(); }
    match /content_knowledge_sessions/{id} { allow read: if true; allow write: if isAdmin(); }
    match /content_strong_believer/{id} { allow read: if true; allow write: if isAdmin(); }
    match /content_marriage_guide/{id} { allow read: if true; allow write: if isAdmin(); }

    // --- SETTINGS & SERVICES ---
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- USERS ---
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isOwner(userId) && canWrite();
      allow update: if (isOwner(userId) || isAdmin()) && canWrite();

      match /{allPaths=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // --- KHATMAS ---
    match /khatmas/{khatmaId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && canWrite();
      allow update: if isAuthenticated() && canWrite();
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.createdBy == request.auth.uid);
    }

    // --- CIRCLES & COMMUNITY ---
    match /prayer_circles/{circleId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }
    
    match /athkar_circles/{circleId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    match /reading_circles/{circleId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /community_posts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && !isBanned() && canWrite();
      allow update: if isAuthenticated() && canWrite();
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.authorId == request.auth.uid);

      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && !isBanned() && canWrite();
        allow update: if isAuthenticated() && canWrite();
        allow delete: if isAdmin() || (isAuthenticated() && resource.data.authorId == request.auth.uid);
      }
    }

    match /dua_requests/{id} {
      allow read: if true;
      allow create: if isAuthenticated() && canWrite();
      allow update: if isAuthenticated() && (
        canWrite() || 
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ameenCount', 'ameeners']))
      );
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    match /community_reports/{reportId} {
      allow create: if isAuthenticated() && canWrite() && request.resource.data.reporterId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }
    
    match /notifications/{notifId} {
      allow read, update, delete: if isAuthenticated() && (isAdmin() || request.auth.uid == resource.data.userId);
      allow create: if isAuthenticated() && canWrite();
    }

    match /community_typing/{roomId} {
      allow read, write: if isAuthenticated();
    }

    match /chat_presence/{docId} {
      allow read, write: if isAuthenticated();
    }

    match /community_messages/{messageId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && !isBanned() && canWrite();
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.senderId == request.auth.uid);
    }

    match /duels/{duelId} {
      allow read: if isAuthenticated() && (isAdmin() || request.auth.uid == resource.data.initiatorId || request.auth.uid == resource.data.targetId);
      allow create: if isAuthenticated() && canWrite() && request.resource.data.initiatorId == request.auth.uid;
      allow update: if isAuthenticated() && canWrite() && (request.auth.uid == resource.data.initiatorId || request.auth.uid == resource.data.targetId);
      allow delete: if false;
    }

    match /knowledge_sessions/{sessionId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && canWrite();
      allow update: if isAuthenticated() && (
        isAdmin() ||
        resource.data.createdBy == request.auth.uid || 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
      );
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.createdBy == request.auth.uid);
    }

    match /private_chats/{chatId} {
      allow read: if isAuthenticated() && (isAdmin() || request.auth.uid in resource.data.participants);
      allow create: if isAuthenticated() && !isBanned() && canWrite() && (request.auth.uid in request.resource.data.participants);
      allow update: if isAuthenticated() && canWrite() && (request.auth.uid in resource.data.participants);
      allow delete: if isAdmin();
      
      match /messages/{messageId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() && !isBanned() && canWrite() && (request.auth.uid in get(/databases/$(database)/documents/private_chats/$(chatId)).data.participants) && request.resource.data.senderId == request.auth.uid;
        allow delete: if isAdmin() || (isAuthenticated() && resource.data.senderId == request.auth.uid);
      }
    }

    // --- COMMUNITY V2 ENHANCEMENTS ---
    match /dua_wall/{id} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && !isBanned() && canWrite() && request.resource.data.userId == request.auth.uid;
      allow update: if isAuthenticated() && canWrite() && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['prayedBy'])
      );
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }

    match /global_milestones/{id} {
      allow read: if true;
      allow update: if isAuthenticated() && canWrite();
      allow create, delete: if isAdmin();
    }

    match /live_dhikr_circles/{id} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && !isBanned() && canWrite();
      allow update: if isAuthenticated() && canWrite() && (
        request.resource.data.diff(resource.data).affectedKeys().hasAny(['currentCount', 'participants', 'activeUsers'])
      );
      allow delete: if isAdmin();
    }
  }
}
