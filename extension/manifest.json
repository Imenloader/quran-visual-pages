{
  "manifest_version": 3,
  "name": "Quraaniat - Quran & Prayer Times",
  "version": "1.0.0",
  "description": "Quick access to Prayer Times, Quran Verses, and Athkar.",
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage", "alarms"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
