```gitignore
# Dependencies
node_modules/

# Build outputs
dist/
build/
*.js.map
*.ts.map

# Environment variables
.env
.env.local
*.env.*

# IDE files
.vscode/
.idea/
*.swp
*.swo
*.tmp

# Logs
*.log

# Coverage
coverage/
htmlcov/
.coverage

# Python cache (if any Python files exist in the project)
__pycache__/
*.pyc
*.pyo
*.pyd

# Distribution / packaging
*.tar.gz
*.whl
*.egg-info/

# OS generated files
.DS_Store
Thumbs.db

# Mobile Signing Keys (Commented out to allow tracking)
# *.jks
# *.keystore
*.p12
*.jks.gpg

```